{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pytest: 現在のファイル",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-s"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python"
        }
    ]
}
